# Server
PORT=3001

# Database
DB_PATH=./data/nexusemail.db

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ZONE_ID=your_zone_id

# AWS Route53
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_HOSTED_ZONE_ID=your_hosted_zone_id

# GoDaddy
GODADDY_API_KEY=your_godaddy_key
GODADDY_API_SECRET=your_godaddy_secret

# App Settings
SCAN_SCHEDULE_ENABLED=true
AUTO_REMEDIATION_ENABLED=false
# Set false to close public workspace self-registration
REGISTRATION_ENABLED=true
# Lifetime of an admin impersonation token, in seconds
IMPERSONATION_TTL_SECONDS=1800
# Production / hosted runtime
NODE_ENV=development
NEXUSEMAIL_DATA_DIR=./data
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change_me

# JWT secret alias
# NEXUSEMAIL_JWT_SECRET=change_me

# Initial platform admin seed / break-glass access
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# Brand protection evidence collection
EVIDENCE_DIR=./data/evidence
EVIDENCE_ENRICH_MAX_PER_SCAN=10
EVIDENCE_RETENTION_DAYS=365
DISABLE_JOB_WORKER=false
JOB_WORKER_POLL_MS=1000

# Optional screenshot collection (leave both unset to skip screenshots)
# SCREENSHOT_SERVICE_URL=https://screenshot.internal.example/render
# SCREENSHOT_SERVICE_TOKEN=
# SCREENSHOT_SERVICE_WIDTH=1280
# SCREENSHOT_SERVICE_HEIGHT=720
# CHROME_BIN=/usr/bin/chromium
# CHROMIUM_BIN=/usr/bin/chromium
# SCREENSHOT_WIDTH=1280
# SCREENSHOT_HEIGHT=720
# SCREENSHOT_TIMEOUT_MS=25000
# SCREENSHOT_NO_SANDBOX=0
# SCREENSHOT_ALLOW_LOCAL=0
